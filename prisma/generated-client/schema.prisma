// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated-client"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  FOLLOW_UP
  WON
  LOST
  PAUSED
}

enum ProductionNeedLevel {
  NONE
  POSSIBLE
  PROBABLE
  CLEAR
}

enum FollowUpActionType {
  EMAIL
  DM
  CALL
  RESEARCH
  OTHER
}

enum ActivityType {
  MESSAGE_SENT
  REPLY_RECEIVED
  FOLLOW_UP_SET
  STATUS_CHANGE
  NOTE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum FileType {
  WORKING
  DELIVERABLE
}

enum ProjectWorkflowStage {
  IN_MIXING
  MIX_APPROVED
  IN_MASTERING
  MASTERED
  COMPLETED
}

enum FileCategory {
  FINAL_MASTER
  FINAL_MIX
  STEMS
  TRACK_OUTS
  INSTRUMENTAL
  ACAPELLA
  REFERENCE
  OTHER
}

enum AudioFormat {
  WAV
  MP3
  AIFF
  FLAC
  ZIP
  OTHER
}

enum SampleRate {
  SR_44_1_KHZ
  SR_48_KHZ
  SR_88_2_KHZ
  SR_96_KHZ
  NOT_APPLICABLE
}

enum BitDepth {
  BIT_16
  BIT_24
  BIT_32_FLOAT
  NOT_APPLICABLE
}

enum FeedbackAuthorRole {
  ARTIST
  ENGINEER
}

enum PaymentMethod {
  STRIPE
  APPLE_PAY
  PAYPAL
  VENMO
  CHIME
  CASH_APP
  WIRE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model Artist {
  id                       String    @id @default(cuid())
  name                     String
  instagramHandle          String?   @unique
  instagramProfileUrl      String?
  instagramProfileImageUrl String?
  spotifyArtistId          String?   @unique
  spotifyArtistUrl         String?
  spotifyImageUrl          String?
  spotifyAccent            String?
  spotifyAccentStrong      String?
  spotifyHighlight         String?
  officialSiteUrl          String?
  location                 String?
  city                     String?
  state                    String?
  country                  String?
  genre                    String?
  tags                     String[]  @default([])
  bio                      String?
  emails                   String[]  @default([])
  followerCount            Int?
  lastPostAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  leads           Lead[]
  releases        Release[]
  instagramPosts  InstagramPost[]
  projects        Project[]
  contactInfos    ContactInfo[]
  primaryMerges   MergeProposal[] @relation("PrimaryMergeProposals")
  duplicateMerges MergeProposal[] @relation("DuplicateMergeProposals")
}

model Lead {
  id                         String              @id @default(cuid())
  artistId                   String
  status                     LeadStatus          @default(NEW)
  score                      Float?
  scoreRationale             String?
  lastContactedAt            DateTime?
  nextActionAt               DateTime?
  followUpActionType         FollowUpActionType?
  productionNeedLevel        ProductionNeedLevel @default(NONE)
  productionNeedEvidence     Json?
  productionNeedEvidenceNote String?
  productionNeedApprovedAt   DateTime?
  productionNeedSource       Json?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  artist              Artist                   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  messages            MessageDraft[]
  activities          Activity[]
  outreachAttempts    OutreachAttempt[]
  replyTriages        ReplyTriage[]
  sequenceEnrollments LeadSequenceEnrollment[]
}

model Release {
  id               String    @id @default(cuid())
  artistId         String
  spotifyTrackId   String?   @unique
  spotifyReleaseId String?   @unique
  title            String
  releaseDate      DateTime?
  imageUrl         String?
  url              String?
  releaseType      String?
  createdAt        DateTime  @default(now())

  artist        Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  trackAnalysis TrackAnalysis?
}

model TrackAnalysis {
  id          String   @id @default(cuid())
  releaseId   String   @unique
  moods       String[] @default([])
  themes      String[] @default([])
  entities    Json?
  explicit    Boolean?
  rating      String?
  mxmTrackId  String?
  mxmArtistId String?
  rawPayload  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
}

model InstagramPost {
  id              String    @id @default(cuid())
  artistId        String
  instagramPostId String?   @unique
  caption         String?
  imageUrl        String?
  postedAt        DateTime?
  url             String?
  createdAt       DateTime  @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
}

model MessageDraft {
  id        String   @id @default(cuid())
  leadId    String
  tone      String?
  body      String
  source    String?
  selected  Boolean  @default(false)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Activity {
  id         String       @id @default(cuid())
  leadId     String
  type       ActivityType
  note       String?
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  replyTriage ReplyTriage?
}

model Project {
  id            String               @id @default(cuid())
  artistId      String
  title         String? // Optional explicit title, otherwise defaults to something like "Project for [Artist Name]"
  portalToken   String               @unique @default(cuid()) // Unique random token for client to access without auth
  status        ProjectStatus        @default(ACTIVE)
  workflowStage ProjectWorkflowStage @default(IN_MIXING)

  // Deliverable Gating
  paywallDeliverables Boolean @default(true)

  // Mix Approval Sign-off
  mixApprovedForMastering Boolean   @default(false)
  mixApprovedAt           DateTime?
  mixApprovedBy           String?
  mixApprovalNotes        String?

  // Mandatory Feedback & Rating Gate
  rating            Int? // 0-5 star rating
  review            String? // Post-project feedback
  ratingSubmittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist       Artist               @relation(fields: [artistId], references: [id], onDelete: Cascade)
  files        ProjectFile[]
  feedbacks    ProjectFeedback[]
  invoice      ProjectInvoice?
  activityLogs ProjectActivityLog[]

  @@index([artistId])
  @@index([portalToken])
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  name      String
  url       String // Can be local path (/uploads/...) or S3 URL
  key       String // Unique identifier/path for the file system or S3 bucket
  size      Int // Size in bytes
  mimeType  String // E.g., 'audio/wav', 'application/pdf'
  type      FileType @default(WORKING)

  // Multi-Format Classification
  category   FileCategory @default(OTHER)
  format     AudioFormat  @default(WAV)
  sampleRate SampleRate   @default(SR_44_1_KHZ)
  bitDepth   BitDepth     @default(BIT_24)

  // Audio Waveform Engine
  duration      Float?
  waveformPeaks Json? // 100-point normalized peaks array
  downloadCount Int    @default(0)

  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feedbacks ProjectFeedback[]

  @@index([projectId, type])
  @@index([category, format, sampleRate])
}

model ProjectFeedback {
  id         String    @id @default(cuid())
  projectId  String
  content    String // Text content of the notes/feedback
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  fileId           String?
  timestamp        Float? // Time in seconds
  authorRole       FeedbackAuthorRole @default(ARTIST)
  authorName       String?
  parentFeedbackId String?

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file           ProjectFile?      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  parentFeedback ProjectFeedback?  @relation("FeedbackReplies", fields: [parentFeedbackId], references: [id], onDelete: Cascade)
  replies        ProjectFeedback[] @relation("FeedbackReplies")

  @@index([projectId, fileId])
}

model ProjectInvoice {
  id            String        @id @default(cuid())
  projectId     String        @unique
  templateId    String?
  invoiceNumber String        @unique
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  currency      String        @default("USD")
  lineItems     Json
  subtotalCents Int
  taxCents      Int           @default(0)
  totalCents    Int
  notes         String?

  selectedPaymentMethod PaymentMethod?
  paymentReference      String?
  stripePaymentUrl      String?
  venmoHandle           String?
  paypalUrl             String?
  chimeTag              String?
  receiptUrl            String?
  paymentNotes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([paidAt])
}

model InvoiceTemplate {
  id                  String   @id @default(cuid())
  name                String
  code                String   @unique
  description         String
  category            String
  lineItems           Json
  suggestedPriceCents Int
  isPreset            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  invoices ProjectInvoice[]

  @@index([code])
}

model ProjectActivityLog {
  id        String   @id @default(cuid())
  projectId String
  actorRole String
  actorName String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model AgentRun {
  id         String    @id @default(cuid())
  agentName  String
  mode       String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String
  totals     Json?
  error      String?
}

model ContactInfo {
  id           String   @id @default(cuid())
  artistId     String
  email        String
  confidence   String   @default("uncertain") // verified, inferred, uncertain
  score        Int      @default(0)
  sourceUrl    String?
  sourceType   String?
  discoveredAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, email])
}

model MergeProposal {
  id                String   @id @default(cuid())
  primaryArtistId   String
  duplicateArtistId String   @unique
  primaryName       String
  duplicateName     String
  similarityScore   Float
  confidence        String // HIGH, MEDIUM, LOW
  reason            String
  status            String   @default("PENDING") // PENDING, APPLIED, REJECTED
  createdAt         DateTime @default(now())

  primaryArtist   Artist @relation("PrimaryMergeProposals", fields: [primaryArtistId], references: [id], onDelete: Cascade)
  duplicateArtist Artist @relation("DuplicateMergeProposals", fields: [duplicateArtistId], references: [id], onDelete: Cascade)
}

// KPI Tracking Models
enum OutreachChannel {
  EMAIL
  INSTAGRAM_DM
  PHONE
  IN_PERSON
  OTHER
}

enum CampaignType {
  NEW_RELEASES
  VENUE_BOOKING
  COLLABORATION
  REENGAGEMENT
  RECRUITMENT
  PORTFOLIO_BUILDING
}

model OutreachCampaign {
  id          String          @id @default(cuid())
  name        String
  type        CampaignType
  channel     OutreachChannel
  startDate   DateTime
  endDate     DateTime?
  targetCount Int             @default(0)
  status      String          @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  attempts OutreachAttempt[]
}

model OutreachAttempt {
  id           String          @id @default(cuid())
  campaignId   String
  leadId       String
  channel      OutreachChannel
  sentAt       DateTime
  respondedAt  DateTime?
  responseType ResponseType? // YES, NO, FOLLOW_UP, NO_RESPONSE
  notes        String?
  createdAt    DateTime        @default(now())

  campaign OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

enum ResponseType {
  YES
  NO
  FOLLOW_UP
  NO_RESPONSE
}

// ─────────────────────────────────────────────────────────────
// Reply Triage & Follow-Up Sequence Models
// ─────────────────────────────────────────────────────────────

enum ReplyIntent {
  INTERESTED
  NOT_NOW
  PRICING_REQUEST
  WRONG_CONTACT
  UNSUBSCRIBED
  BOOKED
  UNCLEAR
}

model ReplyTriage {
  id         String      @id @default(cuid())
  activityId String      @unique
  leadId     String
  intent     ReplyIntent
  note       String?
  triaged    Boolean     @default(false)
  triagedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model FollowUpSequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  steps       Json // Array of { dayOffset: number; tone: string; promptHint: string }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments LeadSequenceEnrollment[]
}

model LeadSequenceEnrollment {
  id          String    @id @default(cuid())
  leadId      String
  sequenceId  String
  currentStep Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  pausedAt    DateTime?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED, CANCELLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lead     Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequence FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([leadId, sequenceId])
  @@index([leadId])
  @@index([sequenceId])
}
